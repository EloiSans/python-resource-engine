{
  "realm": "partner",
  "displayName": "Initech (a partner's SAML identity provider, DEVELOPMENT ONLY)",
  "enabled": true,
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "partner-dev-signing-key",
        "providerId": "rsa",
        "config": {
          "priority": [
            "200"
          ],
          "algorithm": [
            "RS256"
          ],
          "privateKey": [
            ""
          ],
          "certificate": [
            ""
          ]
        }
      }
    ]
  },
  "roles": {
    "realm": [
      {
        "name": "approver",
        "description": "Sent to the invoices realm as Role=approver"
      },
      {
        "name": "accountant",
        "description": "Sent to the invoices realm as Role=accountant"
      }
    ]
  },
  "clients": [
    {
      "clientId": "http://127.0.0.1:8180/realms/invoices",
      "name": "Invoices (Keycloak broker)",
      "description": "The invoices realm as a SAML service provider: its entity id and assertion consumer URL",
      "protocol": "saml",
      "enabled": true,
      "redirectUris": [
        "http://127.0.0.1:8180/realms/invoices/broker/partner-saml/endpoint"
      ],
      "frontchannelLogout": true,
      "attributes": {
        "saml_assertion_consumer_url_post": "http://127.0.0.1:8180/realms/invoices/broker/partner-saml/endpoint",
        "saml_single_logout_service_url_post": "http://127.0.0.1:8180/realms/invoices/broker/partner-saml/endpoint",
        "saml.server.signature": "true",
        "saml.assertion.signature": "true",
        "saml.client.signature": "false",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_name_id_format": "username",
        "saml.force.name.id.format": "true",
        "saml.authnstatement": "true"
      },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "saml",
          "protocolMapper": "saml-role-list-mapper",
          "config": {
            "single": "false",
            "attribute.name": "Role",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "email",
            "attribute.name": "email",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "firstName",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "firstName",
            "attribute.name": "firstName",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "lastName",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "lastName",
            "attribute.name": "lastName",
            "attribute.nameformat": "Basic"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "sara",
      "email": "sara@initech.example",
      "firstName": "Sara",
      "lastName": "Partner",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "approver"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ]
    },
    {
      "username": "tom",
      "email": "tom@initech.example",
      "firstName": "Tom",
      "lastName": "Partner",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "accountant"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ]
    }
  ]
}