{
  "realm": "invoices",
  "displayName": "Invoices (Resource Engine example)",
  "enabled": true,
  "organizationsEnabled": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "invoices-admin",
        "description": "Every organization: the admin system role (cross-tenant)"
      },
      {
        "name": "accountant",
        "description": "Reads the organization's invoices (viewer system role)"
      },
      {
        "name": "approver",
        "description": "Approves and rejects pending invoices under 10,000"
      },
      {
        "name": "issuer",
        "description": "Creates and runs the organization's invoices, customers and tags"
      }
    ]
  },
  "clients": [
    {
      "clientId": "invoices-web",
      "name": "Invoices front end",
      "description": "Public client for the front end: authorization code with PKCE (OAuth 2.1); no password grant",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:*",
        "http://127.0.0.1:*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "email",
        "organization",
        "web-origins",
        "acr"
      ],
      "protocolMappers": [
        {
          "name": "audience-invoices-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "invoices-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "invoices-dev-tests",
      "name": "Local development and tests",
      "description": "DEVELOPMENT ONLY: confidential client with the password grant, so tests and curl can sign in as the demo users. Never create it in a real realm.",
      "enabled": true,
      "publicClient": false,
      "secret": "invoices-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "email",
        "organization",
        "web-origins",
        "acr"
      ],
      "protocolMappers": [
        {
          "name": "audience-invoices-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "invoices-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "root",
      "email": "root@invoices.example",
      "firstName": "Platform",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "invoices-admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ]
    },
    {
