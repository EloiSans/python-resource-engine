{
  "realm": "invoices",
  "displayName": "Invoices (Resource Engine example)",
  "enabled": true,
  "organizationsEnabled": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "invoices-admin",
        "description": "Every organization: the admin system role (cross-tenant)"
      },
      {
        "name": "accountant",
        "description": "Reads the organization's invoices (viewer system role)"
      },
      {
        "name": "approver",
        "description": "Approves and rejects pending invoices under 10,000"
      },
      {
        "name": "issuer",
        "description": "Creates and runs the organization's invoices, customers and tags"
      }
    ]
  },
  "clients": [
    {
      "clientId": "invoices-web",
      "name": "Invoices front end",
      "description": "Public client for the front end: authorization code with PKCE (OAuth 2.1); no password grant",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:*",
        "http://127.0.0.1:*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "email",
        "organization",
        "web-origins",
        "acr"
      ],
      "protocolMappers": [
        {
          "name": "audience-invoices-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "invoices-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "invoices-dev-tests",
      "name": "Local development and tests",
      "description": "DEVELOPMENT ONLY: confidential client with the password grant, so tests and curl can sign in as the demo users. Never create it in a real realm.",
      "enabled": true,
      "publicClient": false,
      "secret": "invoices-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "email",
        "organization",
        "web-origins",
        "acr"
      ],
      "protocolMappers": [
        {
          "name": "audience-invoices-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "invoices-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "root",
      "email": "root@invoices.example",
      "firstName": "Platform",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "invoices-admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ]
    },
    {
      "username": "ada",
      "email": "ada@acme.example",
      "firstName": "Ada",
      "lastName": "Accountant",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "accountant"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ]
    },
    {
      "username": "pau",
      "email": "pau@acme.example",
      "firstName": "Pau",
      "lastName": "Approver",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "approver"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ]
    },
    {
      "username": "eli",
      "email": "eli@acme.example",
      "firstName": "Eli",
      "lastName": "Issuer",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "issuer"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ]
    },
    {
      "username": "gina",
      "email": "gina@globex.example",
      "firstName": "Gina",
      "lastName": "Issuer",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "issuer"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ]
    }
  ],
  "organizations": [
    {
      "name": "ACME",
      "alias": "acme",
      "enabled": true,
      "domains": [
        {
          "name": "acme.example",
          "verified": false
        }
      ],
      "members": [
        {
          "username": "ada"
        },
        {
          "username": "pau"
        },
        {
          "username": "eli"
        }
      ]
    },
    {
      "name": "Globex",
      "alias": "globex",
      "enabled": true,
      "domains": [
        {
          "name": "globex.example",
          "verified": false
        }
      ],
      "members": [
        {
          "username": "gina"
        }
      ]
    },
    {
      "name": "Initech",
      "alias": "initech",
      "enabled": true,
      "domains": [
        {
          "name": "initech.example",
          "verified": true
        }
      ],
      "identityProviders": [
        {
          "alias": "partner-saml"
        }
      ],
      "members": []
    }
  ],
  "identityProviders": [
    {
      "alias": "partner-saml",
      "displayName": "Initech (SAML)",
      "providerId": "saml",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "entityId": "http://127.0.0.1:8180/realms/invoices",
        "idpEntityId": "http://127.0.0.1:8180/realms/partner",
        "singleSignOnServiceUrl": "http://127.0.0.1:8180/realms/partner/protocol/saml",
        "singleLogoutServiceUrl": "http://127.0.0.1:8180/realms/partner/protocol/saml",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified",
        "principalType": "SUBJECT",
        "postBindingResponse": "true",
        "postBindingAuthnRequest": "true",
        "postBindingLogout": "true",
        "validateSignature": "true",
        "signingCertificate": "",
        "wantAssertionsSigned": "true",
        "wantAuthnRequestsSigned": "false",
        "syncMode": "FORCE",
        "kc.org.domain": "initech.example",
        "kc.org.broker.redirect.mode.email-matches": "true"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "Role approver",
      "identityProviderAlias": "partner-saml",
      "identityProviderMapper": "saml-role-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "attribute.name": "Role",
        "attribute.value": "approver",
        "role": "approver"
      }
    },
    {
      "name": "Role accountant",
      "identityProviderAlias": "partner-saml",
      "identityProviderMapper": "saml-role-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "attribute.name": "Role",
        "attribute.value": "accountant",
        "role": "accountant"
      }
    },
    {
      "name": "email",
      "identityProviderAlias": "partner-saml",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "attribute.name": "email",
        "user.attribute": "email"
      }
    },
    {
      "name": "firstName",
      "identityProviderAlias": "partner-saml",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "attribute.name": "firstName",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "lastName",
      "identityProviderAlias": "partner-saml",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "attribute.name": "lastName",
        "user.attribute": "lastName"
      }
    }
  ]
}